#!/bin/bash
set -uo pipefail
DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)}"
# shellcheck source=.setup-lib
# .setup-lib is required: a failed source must be fatal (no set -e, so a
# bare source would be silently ignored).
source "$DOTFILES_DIR/.setup-lib" || {
  echo "error: missing $DOTFILES_DIR/.setup-lib (incomplete dotfiles tree; re-run install.sh to re-fetch it)" >&2
  exit 1
}

gtkrc_content() {
  cat <<EOF
# DO NOT EDIT! This file will be overwritten by nwg-look.
# Any customization should be done in ~/.gtkrc-2.0.mine instead.

include "$HOME/.gtkrc-2.0.mine"
gtk-theme-name="Materia-dark"
gtk-icon-theme-name="Qogir-dark"
gtk-font-name="Cantarell 11"
gtk-cursor-theme-name="Bibata-Modern-Classic"
gtk-cursor-theme-size=24
gtk-toolbar-style=GTK_TOOLBAR_ICONS
gtk-toolbar-icon-size=GTK_ICON_SIZE_LARGE_TOOLBAR
gtk-button-images=0
gtk-menu-images=0
gtk-enable-event-sounds=1
gtk-enable-input-feedback-sounds=0
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle="hintslight"
gtk-xft-rgba="rgb"
EOF
}

f="$HOME/.gtkrc-2.0"
new=$(gtkrc_content)
if [[ -f $f && "$(<"$f")" == "$new" ]]; then
  info "$f unchanged; skipping"
else
  # Never overwrite when the backup failed: that would lose the existing
  # file without keeping a copy.
  if ! backup_path "$f"; then
    warn "backup failed for $f; not overwriting it"
  else
    printf '%s\n' "$new" > "$f"
    info "wrote $f"
  fi
fi

# Set dark mode for portal-aware apps (Firefox, Electron, libadwaita)
run gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
