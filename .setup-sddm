#!/bin/bash
set -uo pipefail
DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)}"
# shellcheck source=.setup-lib
# .setup-lib is required: a failed source must be fatal (no set -e, so a
# bare source would be silently ignored).
source "$DOTFILES_DIR/.setup-lib" || {
  echo "error: missing $DOTFILES_DIR/.setup-lib (incomplete dotfiles tree; re-run install.sh to re-fetch it)" >&2
  exit 1
}

run sudo mkdir -p /etc/sddm.conf.d

run sudo rm -f /etc/sddm.conf
run sudo cp "$DOTFILES_DIR/.config/sddm/sddm.conf" /etc/sddm.conf

run sudo rm -f /etc/sddm.conf.d/virtualkbd.conf
run sudo cp "$DOTFILES_DIR/.config/sddm/virtualkbd.conf" /etc/sddm.conf.d/virtualkbd.conf

THEME=/usr/share/sddm/themes/sddm-astronaut-theme
if [[ -d $THEME ]]; then
  run sudo chown -R "${USER:-$(id -un)}:$(id -gn)" "$THEME"

  run sudo rm -f "$THEME/Themes/hyprlock.template.conf"
  run cp "$DOTFILES_DIR/.config/sddm/hyprlock.template.conf" "$THEME/Themes/hyprlock.template.conf"

  run sudo rm -f "$THEME/metadata.desktop"
  run cp "$DOTFILES_DIR/.config/sddm/metadata.desktop" "$THEME/metadata.desktop"
else
  warn "$THEME not found (is sddm-astronaut-theme installed?) – skipping theme files"
fi

run sudo systemctl enable sddm
