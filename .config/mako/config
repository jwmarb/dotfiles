# Take a look at the mako manpage with the command:
#   man 5 mako
# To view all configuration options.

font=FiraCodeNerdFont 10
format=<b>%a ⏵</b> %s\n%b
sort=-time
layer=overlay
anchor=top-right
background-color=#0e0a17
width=300
height=110
margin=5
padding=0,5,10
border-size=2
border-color=#5C5E8F
border-radius=8
icons=1
max-icon-size=64
default-timeout=5000
ignore-timeout=1

[urgency=normal]
border-color=#5C5E8F

[urgency=high]
border-color=#9B7188
default-timeout=0

[summary~="log-.*"]
border-color=#708BA5

# makoctl reload // Load last config
# makoctl restore // Load last notify
